# --- Snowflake (analytical source of truth; server-side only) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_ROLE=BUSINESS_ANALYST1
SNOWFLAKE_WAREHOUSE=SNITCH_WH
SNOWFLAKE_DATABASE=SNITCH_DB
SNOWFLAKE_SCHEMA=MAPLEMONK
# Auth: PAT is used when set (the account's auth policy rejects key-pair for this user).
SNOWFLAKE_PAT=
# Optional key-pair fallback (base64 body of encrypted PKCS8 key, no PEM header)
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Result cache TTL in seconds for current-period queries
SNOWFLAKE_CACHE_TTL=600

# --- PostgreSQL (application data: targets, users, settings, audit) ---
DATABASE_URL=postgres://user:pass@host:5432/longtail

# --- Auth: Google sign-in, restricted to allowed emails ---
# google: Sign in with Google (production). dev: act as DEV_USER_EMAIL (local only; ignored in production)
AUTH_MODE=google
# Public URL of the app (used for the Google redirect URI) and cookie-signing secret (≥32 chars)
NEXTAUTH_URL=https://longtail.snitch-workflow.com
NEXTAUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in (comma-separated). Admins can also add people in Users & Access.
ADMIN_EMAILS=
ALLOWED_EMAILS=
# Optional: allow a whole domain, e.g. snitch.com (leave empty to allow listed emails only)
ALLOWED_EMAIL_DOMAINS=
SESSION_DAYS=7
DEV_USER_EMAIL=
