# --- Snowflake (analytical source of truth; server-side only) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_ROLE=BUSINESS_ANALYST1
SNOWFLAKE_WAREHOUSE=SNITCH_WH
SNOWFLAKE_DATABASE=SNITCH_DB
SNOWFLAKE_SCHEMA=MAPLEMONK
# Auth: PAT is used when set (the account's auth policy rejects key-pair for this user).
SNOWFLAKE_PAT=
# Optional key-pair fallback (base64 body of encrypted PKCS8 key, no PEM header)
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Result cache TTL in seconds for current-period queries
SNOWFLAKE_CACHE_TTL=600

# --- PostgreSQL (application data: targets, users, settings, audit) ---
DATABASE_URL=postgres://user:pass@host:5432/longtail

# --- Auth: username + password (accounts are created by admins in Admin → Users & Access) ---
# Session-signing secret (≥32 random characters)
NEXTAUTH_SECRET=
# Public URL (https → Secure cookies)
NEXTAUTH_URL=https://longtail.snitch-workflow.com
# First admin account, created automatically on first start if it doesn't exist.
# Afterwards the password is managed in the app (changing ADMIN_PASSWORD later does not reset it).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_DAYS=7
# Local development only: AUTH_MODE=dev skips login (ignored in production builds)
AUTH_MODE=

# --- AI Business Copilot (Products → AI Bot) ---
# snowflake (default): Claude via Snowflake Cortex, using SNOWFLAKE_PAT above — no separate key or billing.
# anthropic: api.anthropic.com with ANTHROPIC_API_KEY.
AI_PROVIDER=snowflake
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — higher = deeper analysis, slower and costlier
AI_EFFORT=medium
AI_QUESTIONS_PER_HOUR=60
